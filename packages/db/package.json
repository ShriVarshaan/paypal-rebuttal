{
  "name": "@rebuttal/db",
  "version": "0.0.0",
  "private": true,
  "description": "Prisma schema and client shared by api and worker.",
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./seed": "./src/seed.ts"
  },
  "scripts": {
    "postinstall": "prisma generate",
    "generate": "prisma generate",
    "migrate:deploy": "prisma migrate deploy",
    "migrate:dev": "prisma migrate dev",
    "typecheck": "tsc -p .",
    "test": "vitest run --passWithNoTests"
  },
  "dependencies": {
    "@rebuttal/core": "workspace:*",
    "@rebuttal/decision": "workspace:*",
    "@prisma/client": "7.10.1",
    "@prisma/adapter-pg": "7.10.1"
  },
  "devDependencies": {
    "@rebuttal/testkit": "workspace:*",
    "prisma": "7.10.1"
  }
}
