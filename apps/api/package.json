{
  "name": "@rebuttal/api",
  "version": "0.0.0",
  "private": true,
  "description": "Fastify API: PayPal webhooks and REST for the web app.",
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=../../.env src/main.ts",
    "start": "tsx src/main.ts",
    "typecheck": "tsc -p .",
    "test": "vitest run --passWithNoTests",
    "test:e2e": "vitest run test/e2e.test.ts"
  },
  "dependencies": {
    "@rebuttal/core": "workspace:*",
    "@rebuttal/db": "workspace:*",
    "@rebuttal/paypal": "workspace:*",
    "fastify": "^5.6.0",
    "@fastify/cors": "^11.0.0",
    "@fastify/rate-limit": "^11.0.0",
    "pg-boss": "^12.0.0",
    "zod": "^4.1.0",
    "@rebuttal/worker": "workspace:*",
    "tsx": "^4.20.0",
    "@rebuttal/agent": "workspace:*",
    "@rebuttal/decision": "workspace:*"
  },
  "devDependencies": {
    "@rebuttal/testkit": "workspace:*",
    "@rebuttal/connectors": "workspace:*"
  }
}
