# PayPal sandbox (developer.paypal.com > Apps & Credentials > Sandbox)
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_BASE_URL=https://api-m.sandbox.paypal.com
# From your app's Webhooks section. Each person's app has its own id.
PAYPAL_WEBHOOK_ID=
# Where disputes list/show go: "toolkit" (@paypal/agent-toolkit, default) or "rest"
PAYPAL_DISPUTES_VIA=toolkit

# Anthropic. Empty = agents use deterministic templates (no Claude calls).
ANTHROPIC_API_KEY=
# Set to 1 to keep agents on templates even with a key (e.g. offline demos).
AGENTS_DISABLED=

# Database (docker compose or `pnpm db:embedded`)
DATABASE_URL=postgresql://rebuttal:rebuttal@localhost:5432/rebuttal

# EasyPost (test mode). Empty = offline tracker stand-in.
EASYPOST_API_KEY=

# Demo store API (apps/demo-store) for the messages/download-log/account connectors.
# Empty (or SIMULATOR=1) = fixtures/store/store.json. See packages/connectors/STORE_API.md.
STORE_API_URL=
STORE_API_TOKEN=

# API
PORT=3001
WEB_ORIGIN=http://localhost:3000
# Bearer token for the REST routes; required in production.
API_TOKEN=
LOG_LEVEL=info

# Dev only, refused when NODE_ENV=production:
# SIMULATOR=1 serves PayPal from fixtures/ and accepts unsigned webhooks.
SIMULATOR=
# Accept webhooks without signature verification (sandbox debugging).
WEBHOOK_SKIP_VERIFY=
# Set to 1 to turn off the 60s polling backstop.
POLL_DISABLED=
# Where the sim/sandbox scripts post synthetic webhooks.
API_URL=http://localhost:3001
